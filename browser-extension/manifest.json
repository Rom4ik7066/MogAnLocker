{
  "manifest_version": 3,
  "name": "MogLocker AdBlock",
  "version": "1.0.0",
  "description": "Локальная блокировка сетевых рекламных и трекинговых правил с управлением из MogLocker.",
  "key": "",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MogLocker AdBlock",
    "default_popup": "popup.html"
  }
}
